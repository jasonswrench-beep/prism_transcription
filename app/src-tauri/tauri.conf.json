{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism Transcribe",
  "version": "0.0.1",
  "identifier": "io.github.jasonswrench-beep.prismtranscribe",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5291"
  },
  "app": {
    "windows": [
      {
        "title": "Prism Transcribe",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis"
    ],
    "publisher": "Prism Transcribe contributors",
    "copyright": "Apache License 2.0",
    "shortDescription": "Transcribe interviews and focus groups on your own computer and send them to PrismQDA",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "licenseFile": "../../LICENSE"
  }
}
