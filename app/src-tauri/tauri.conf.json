{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism Transcribe",
  "version": "0.1.0-alpha.2",
  "identifier": "io.github.jasonswrench-beep.prismtranscribe",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5291"
  },
  "app": {
    "windows": [
      {
        "title": "Prism Transcribe",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' http://media.localhost media:; connect-src ipc: http://ipc.localhost http://media.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Prism Transcribe contributors",
    "copyright": "Apache License 2.0",
    "shortDescription": "Transcribe interviews and focus groups on your own computer and send them to PrismQDA",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "licenseFile": "../../LICENSE",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../THIRD-PARTY.md": "THIRD-PARTY.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
